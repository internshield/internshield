# Neon PostgreSQL pooled connection string. Keep private; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a random secret of at least 32 characters, for example with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Transitional only: current visual scaffold still imports Supabase.
# The Neon API is being built and verified before any portal is switched over.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
